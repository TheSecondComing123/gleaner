{
  "name": "gleaner",
  "displayName": "Gleaner",
  "description": "Errors from any command you run in the terminal, in the Problems panel. No tasks.json.",
  "version": "0.1.0",
  "publisher": "gleaner",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "problems",
    "terminal",
    "errors",
    "problem matcher",
    "diagnostics"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {},
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "watch": "pnpm build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fixture": "esbuild scripts/fixture.ts --bundle --platform=node --log-level=warning --outfile=dist/fixture.js && node dist/fixture.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.93.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "extensionKind": [
    "workspace"
  ]
}
