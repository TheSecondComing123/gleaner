{
  "name": "gleaner",
  "displayName": "Gleaner",
  "description": "turns errors from commands you run in the terminal into problems and squiggles in your code.",
  "version": "0.6.0",
  "publisher": "thesecondcoming123",
  "license": "MIT",
  "author": {
    "name": "Alan Bagel",
    "url": "https://alanthebagel.com"
  },
  "private": true,
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "problems",
    "terminal",
    "errors",
    "problem matcher",
    "diagnostics"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onTerminalShellIntegration:*",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gleaner.copyProblems",
        "title": "Copy Problems",
        "category": "Gleaner"
      },
      {
        "command": "gleaner.showOutput",
        "title": "Show Output",
        "category": "Gleaner"
      },
      {
        "command": "gleaner.clear",
        "title": "Clear Problems",
        "category": "Gleaner"
      }
    ],
    "configuration": {
      "title": "Gleaner",
      "properties": {
        "gleaner.runSummaries": {
          "type": "boolean",
          "default": false,
          "description": "Pilot: show what changed after a comparable, complete rerun in the status bar."
        },
        "gleaner.enable": {
          "type": "boolean",
          "default": true,
          "description": "Read terminal command output and show its errors in the Problems panel."
        },
        "gleaner.hideDuplicates": {
          "type": "boolean",
          "default": true,
          "description": "Hide a problem when another extension, like a language server, already reports it at the same spot."
        },
        "gleaner.extensionMatchers": {
          "type": "boolean",
          "default": true,
          "description": "Use problem matchers from installed extensions for commands Gleaner has no parser for."
        },
        "gleaner.pathMappings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Map printed path prefixes to workspace paths, for example `{ \"/app/src\": \"src\" }`. The longest whole-component prefix wins, before file lookup. Relative targets use the workspace folder; in multi-root workspaces use `${workspaceFolder:name}`. `${workspaceFolder}` works with one folder. Missing mapped files are logged and use normal lookup."
        },
        "gleaner.ignoredCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "cd",
            "ls",
            "cat",
            "bat",
            "less",
            "more",
            "head",
            "tail",
            "grep",
            "rg",
            "ag",
            "find",
            "fd",
            "git",
            "echo",
            "printf",
            "man",
            "which",
            "diff",
            "jq",
            "tree",
            "code",
            "vim",
            "nvim",
            "nano",
            "ssh",
            "curl",
            "wget",
            "brew"
          ],
          "markdownDescription": "Commands Gleaner never reads, even when their output looks like errors (for example `cat build.log`). Only applies to commands Gleaner has no parser for."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "watch": "pnpm build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fixture": "esbuild scripts/fixture.ts --bundle --platform=node --log-level=warning --outfile=dist/fixture.js && node dist/fixture.js",
    "e2e": "pnpm build && node scripts/e2e.mjs",
    "package": "pnpm build --minify && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.93.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/icon.png",
  "homepage": "https://github.com/TheSecondComing123/gleaner#readme",
  "bugs": {
    "url": "https://github.com/TheSecondComing123/gleaner/issues"
  },
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheSecondComing123/gleaner.git"
  }
}
